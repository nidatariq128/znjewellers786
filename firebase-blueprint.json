{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, contact details, and saved delivery addresses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["customer", "admin"], "maxLength": 32 },
        "addresses": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Jewellery, watch, bangle, or handbag product with specifications and pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "sku": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "images": { "type": "array" },
        "description": { "type": "string", "maxLength": 2000 },
        "material": { "type": "string", "maxLength": 200 },
        "waterproofGrade": { "type": "string", "maxLength": 128 },
        "customizationNotice": { "type": "string", "maxLength": 300 },
        "goldPurity": { "type": "string", "maxLength": 128 },
        "weightGrams": { "type": "number" },
        "diamondDetails": { "type": "string", "maxLength": 300 },
        "ringSizes": { "type": "array" },
        "stock": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "price", "stock"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Storefront collection category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "tagline": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 2000 },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with payment verification and fulfillment tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 64 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "discount": { "type": "number" },
        "appliedPromo": { "type": "string", "maxLength": 64 },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod", "bank_transfer", "jazzcash", "easypaisa", "online_card"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "paymentReference": { "type": "string", "maxLength": 128 },
        "paymentProofUrl": { "type": "string", "maxLength": 400000 },
        "paymentVerificationHistory": { "type": "array" },
        "orderStatus": { "type": "string", "enum": ["Order Placed", "Confirmed", "Processing", "Shipped", "Out for Delivery", "Delivered", "Cancelled"] },
        "trackingNumber": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "stockRestored": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "total", "paymentMethod", "orderStatus"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "User saved jewellery items",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "productIds"]
    },
    "Review": {
      "title": "Review",
      "description": "Authenticated customer product rating and review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "userId", "rating", "comment", "userName"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "VIP newsletter subscriber email",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 128 },
        "subscribedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer concierge contact inquiry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "reviewed", "resolved"], "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "email", "phone", "message", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon managed by store administrators",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["percent", "fixed"], "maxLength": 16 },
        "value": { "type": "number" },
        "minSubtotal": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" }
      },
      "required": ["code", "type", "value", "active"]
    },
    "InventoryLog": {
      "title": "InventoryLog",
      "description": "Immutable inventory movement audit entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "delta": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "enum": ["order_placed", "order_cancelled_restore", "admin_adjustment", "initial_seed"], "maxLength": 64 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "actor": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "delta", "newStock", "reason", "createdAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Payment verification and transaction log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["cod", "bank_transfer", "jazzcash", "easypaisa", "online_card"] },
        "status": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "reference": { "type": "string", "maxLength": 128 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderId", "userId", "amount", "method", "status"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Storewide configuration, contacts, shipping, and merchant accounts",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 128 },
        "storeAddress": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "freeShippingThreshold": { "type": "number" },
        "standardShippingFee": { "type": "number" },
        "shippingRateKarachi": { "type": "number" },
        "shippingRateNationwide": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user account information"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Privileged admin registry verified by server and rules"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stores jewellery catalogue products"
    },
    "/collections/{collectionId}": {
      "schema": { "$ref": "#/entities/Collection" },
      "description": "Stores custom boutique collections"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores customer orders and tracking status"
    },
    "/wishlists/{userId}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "Stores private user wishlists"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Stores verified customer reviews"
    },
    "/subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/Subscriber" },
      "description": "Stores newsletter subscribers"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Stores customer contact inquiries"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Stores promotional discount vouchers"
    },
    "/inventory_logs/{logId}": {
      "schema": { "$ref": "#/entities/InventoryLog" },
      "description": "Stores immutable inventory change history"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Stores payment audit records"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Stores system settings and shipping rules"
    }
  }
}
